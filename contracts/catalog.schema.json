{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lamhoangcatvy/ohmywork/main/contracts/catalog.schema.json",
  "title": "ohmywork catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "name", "version", "description", "skills"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "$ref": "#/$defs/semver" },
    "name": { "const": "ohmywork" },
    "version": { "$ref": "#/$defs/semver" },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "manifest", "maturity"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "path": { "type": "string", "pattern": "^\\.agents/skills/[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "manifest": { "type": "string", "pattern": "^\\.agents/skills/.+/capability\\.json$" },
          "maturity": { "enum": ["experimental", "stable", "deprecated", "revoked"] }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    }
  }
}
