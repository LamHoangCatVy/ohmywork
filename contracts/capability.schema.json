{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lamhoangcatvy/ohmywork/main/contracts/capability.schema.json",
  "title": "ohmywork capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "version",
    "title",
    "summary",
    "owner",
    "maturity",
    "roles",
    "lifecycleStages",
    "contract",
    "execution",
    "risk",
    "permissions",
    "assurance",
    "observability",
    "supplyChain",
    "compatibility",
    "support"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "$ref": "#/$defs/semver" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/semver" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "contact"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "contact": { "type": "string", "format": "uri" }
      }
    },
    "maturity": { "enum": ["experimental", "stable", "deprecated", "revoked"] },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "lifecycleStages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "idea",
          "requirements",
          "design",
          "plan",
          "build",
          "test",
          "assure",
          "release",
          "deploy",
          "operate",
          "gateway",
          "memory",
          "learn",
          "govern"
        ]
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs", "errors", "preconditions", "postconditions"],
      "properties": {
        "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } },
        "preconditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "postconditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "idempotent", "timeoutSeconds", "retry", "rollback"],
      "properties": {
        "kind": { "enum": ["deterministic", "model-guided", "hybrid"] },
        "idempotent": { "type": "boolean" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "retry": { "type": "string", "minLength": 1 },
        "rollback": { "type": "string", "minLength": 1 }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "sideEffects", "approval"],
      "properties": {
        "tier": { "enum": ["T0", "T1", "T2", "T3", "T4", "T5"] },
        "sideEffects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "none",
              "workspace-read",
              "workspace-write",
              "network-read",
              "external-write",
              "destructive",
              "publish",
              "deploy",
              "memory-write",
              "privilege-change"
            ]
          }
        },
        "approval": { "enum": ["none", "host-policy", "explicit-user", "two-person", "forbidden"] }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem", "network", "tools", "secrets", "memory"],
      "properties": {
        "filesystem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write"],
          "properties": {
            "read": { "$ref": "#/$defs/stringSet" },
            "write": { "$ref": "#/$defs/stringSet" }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "allowlist"],
          "properties": {
            "mode": { "enum": ["none", "host-mediated-read", "scoped-write"] },
            "allowlist": { "$ref": "#/$defs/stringSet" }
          }
        },
        "tools": { "$ref": "#/$defs/stringSet" },
        "secrets": { "$ref": "#/$defs/stringSet" },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "write"],
          "properties": {
            "read": { "type": "boolean" },
            "write": { "type": "boolean" }
          }
        }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "evals", "threatModel"],
      "properties": {
        "tests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "evals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/eval" } },
        "threatModel": { "type": "string", "minLength": 1 }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceFields", "metrics", "capture", "sensitiveData"],
      "properties": {
        "traceFields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "capture": { "enum": ["none", "metadata-only", "redacted-content", "full-content-with-consent"] },
        "sensitiveData": { "enum": ["exclude", "redact", "explicit-consent"] }
      }
    },
    "supplyChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "source", "dependencies"],
      "properties": {
        "license": { "type": "string", "pattern": "^[A-Za-z0-9-.+]+$" },
        "source": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentSkillsSpec", "hosts"],
      "properties": {
        "agentSkillsSpec": { "type": "string", "minLength": 1 },
        "hosts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "security"],
      "properties": {
        "level": { "enum": ["community", "maintained", "critical"] },
        "security": { "type": "string", "format": "uri" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mediaType", "required"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "mediaType": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "template": { "type": "string", "minLength": 1 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "meaning", "recovery"],
      "properties": {
        "code": { "$ref": "#/$defs/id" },
        "meaning": { "type": "string", "minLength": 1 },
        "recovery": { "type": "string", "minLength": 1 }
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metric", "threshold"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "metric": { "type": "string", "minLength": 1 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
